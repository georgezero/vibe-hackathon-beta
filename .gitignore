# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local.db
local.db-wal
local.db-shm
drizzle/

# Local qualification/runtime artifacts (durable docs and screenshots remain tracked)
/cloneDB
/cloneDB-*
/local.db*.bak
/local.db*.bak-shm
/local.db*.bak-wal
/*.sqlite.bak
/*.sqlite3.bak
/test-results/
/playwright-report/
/blob-report/
/.claude/
/.codex/
/.impeccable/
/backups/
/repository-snapshots/

# Private databases, fixture credentials, and seed snapshots
/data/
/database-snapshots/
/credentials/
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
