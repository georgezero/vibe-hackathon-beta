# ── Database ───────────────────────────────────────────────
# Local SQLite (default): leave DATABASE_URL unset
# DB_FILE_NAME=local.db

# Turso/libSQL (production):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your_turso_auth_token

# ── Local admin development fallback ───────────────────────
# Only exact NODE_ENV=development permits this fallback. Test, production, and
# missing/empty/unknown runtime values fail closed.
# ADMIN_TOKEN=local_development_only

# ── Viby admin identity confirmation ───────────────────────
VIBY_BASE_URL=http://localhost:3001
VIBY_APP_SLUG=vibe-hackathon
# Server-only HMAC key for one-time callback correlation. Required outside development.
# VIBY_CALLBACK_STATE_SECRET=
VIBE_ADMIN_VIBY_USER_IDS=
VIBE_STAFF_VIBY_USER_IDS=
VIBE_ADMIN_SESSION_TTL_SECONDS=43200
# Optional explicit local fallback. Keep unset/false outside development.
# VIBE_ENABLE_ADMIN_DEV_FALLBACK=false
# Required in every production-safe runtime. Use an independent random value of
# at least 32 characters; Better Auth secrets are not a fallback.
# VIBE_ADMIN_SESSION_SECRET=
# Optional cookie secure override. By default secure cookies are used when
# VIBE_HACKATHON_BASE_URL starts with https://.
# Native team chat is opt-in for a controlled pilot. Leave disabled until the
# predeployment gate is approved; optionally restrict it to comma-separated
# submission IDs with VIBE_NATIVE_TEAM_CHAT_SUBMISSIONS.
VIBE_NATIVE_TEAM_CHAT_ENABLED=false
# VIBE_NATIVE_TEAM_CHAT_SUBMISSIONS=sub_example1,sub_example2
# VIBE_ADMIN_COOKIE_SECURE=

# D.4 synthetic publication qualification. Keep disabled and empty outside a
# bounded operator-approved fixture run; malformed values fail closed.
VIBE_PUBLICATION_QUALIFICATION_ENABLED=false
# VIBE_PUBLICATION_QUALIFICATION_SUBMISSION_ALLOWLIST=sub_example1

# ── Judge authorization ─────────────────────────────────────
# Judges use the same Better Auth application session as every other user.
# Access is resolved from event-scoped judge_authorizations.
VIBE_JUDGE_EVENT_ID=evt_vibe_2025

# ── GitHub OAuth (Better Auth — recovery only) ─────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Better Auth ────────────────────────────────────────────
# BETTER_AUTH_SECRET=generate_a_random_secret_here
# BETTER_AUTH_URL=http://localhost:3000

# ── Anthropic (for AI judging, future) ────────────────────
# ANTHROPIC_API_KEY=

# ── Canonical base URL ─────────────────────────────────────
# Set this to your deployment URL. Used in generated prompts, packets,
# curl commands, import URLs, and /api/v1/spec.
# REQUIRED outside exact NODE_ENV=development. Production-safe modes require
# an HTTPS origin URL with no path, query, fragment, or credentials.
# VIBE_HACKATHON_BASE_URL=https://rsna-vibe.example.com

# ── LLM judging ────────────────────────────────────────────
# AI_JUDGE_MODE=mock        # (default) deterministic mock — no API key needed
# AI_JUDGE_MODE=anthropic   # requires ANTHROPIC_API_KEY
# AI_JUDGE_MODE=openai      # requires OPENAI_API_KEY
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Event branding (optional — DB values take priority) ────
# Override event display name and logo shown in Nav, headers, and /api/v1/spec.
# These are fallbacks; the active event's displayName/logoUrl DB fields take precedence.
# VIBE_HACKATHON_EVENT_NAME="RSNA 2026"
# VIBE_HACKATHON_EVENT_LOGO_URL="https://www.rsna.org/-/media/images/rsna/annual-meeting/2026/rsna_2026_logo_color_fin.png"

# ── Status page — event host location (for institution map arcs) ────────────
# Defaults to Chicago (RSNA). Set to your event host city/lat/lng.
# VIBE_HACKATHON_EVENT_HOST_CITY="Chicago"
# VIBE_HACKATHON_EVENT_HOST_REGION="IL"
# VIBE_HACKATHON_EVENT_HOST_COUNTRY="USA"
# VIBE_HACKATHON_EVENT_HOST_LAT="41.8781"
# VIBE_HACKATHON_EVENT_HOST_LNG="-87.6298"
